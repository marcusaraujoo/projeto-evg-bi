        "lineageTag": "1fae6417-850c-45bc-83e2-b75c13eac0fb",
        "partitions": [
          {
            "name": "dim_calendario",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "VAR DataMinima = MIN(f_amostra_evg[dt_matricula])",
                "VAR DataMaxima = MAX(f_amostra_evg[dt_matricula])",
                "RETURN",
                "ADDCOLUMNS (",
                "    CALENDAR ( DataMinima, DataMaxima ),",
                "    \"Ano\", YEAR ( [Date] ),",
                "    \"Mês Num\", MONTH ( [Date] ),",
                "    \"Nome Mês\", FORMAT ( [Date], \"mmmm\", \"pt-BR\" ),",
                "    \"Ano-Mês\", FORMAT ( [Date], \"yyyy-mm\" ),",
                "    \"Trimestre\", \"T\" & FORMAT ( [Date], \"q\" )",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
