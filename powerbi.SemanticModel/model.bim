          {
            "name": "f_amostra_evg",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = OBT_EVG,",
                "    #\"Outras Colunas Removidas\" = Table.SelectColumns(Fonte,{\"cod_matricula\", \"cod_curso\", \"cod_turma\", \"dt_matricula\", \"codigo_pessoa\", \"poder\", \"esfera\", \"conteudista\", \"sit_matricula\", \"dt_fim\"}),",
                "    #\"Consultas Mescladas\" = Table.NestedJoin(#\"Outras Colunas Removidas\", {\"poder\"}, dim_poder, {\"poder\"}, \"dim_poder\", JoinKind.LeftOuter),",
                "    #\"dim_poder Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas\", \"dim_poder\", {\"id_poder\"}, {\"id_poder\"}),",
                "    #\"Consultas Mescladas1\" = Table.NestedJoin(#\"dim_poder Expandido\", {\"esfera\"}, dim_esfera, {\"esfera\"}, \"dim_esfera\", JoinKind.LeftOuter),",
                "    #\"dim_esfera Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas1\", \"dim_esfera\", {\"id_esfera\"}, {\"id_esfera\"}),",
                "    #\"Consultas Mescladas2\" = Table.NestedJoin(#\"dim_esfera Expandido\", {\"conteudista\"}, dim_conteudista, {\"conteudista\"}, \"dim_conteudista\", JoinKind.LeftOuter),",
                "    #\"dim_conteudista Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas2\", \"dim_conteudista\", {\"id_conteudista\"}, {\"id_conteudista\"}),",
                "    #\"Colunas Removidas\" = Table.RemoveColumns(#\"dim_conteudista Expandido\",{\"poder\", \"esfera\", \"conteudista\"}),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Colunas Removidas\",{{\"dt_matricula\", type date}, {\"dt_fim\", type date}})",
                "in",
                "    #\"Tipo Alterado\""
              ],
              "type": "m"
            }
          }
        ]
      },
